        {
          "path": "gameplay.careerStarted",
          "op": "eq",
          "value": false
        }
      ],
      "menuTap": true
    },
    {
      "name": "Create original career save",
      "keys": [
        "A"
      ],
      "holdMs": 100,
      "timeoutSeconds": 30,
      "expect": [
        {
          "path": "gameplay.careerStarted",
          "op": "eq",
          "value": true
        }
      ],
      "menuTap": true
    },
    {
      "name": "Return to title",
      "keys": [
        "B"
      ],
      "holdMs": 100,
      "timeoutSeconds": 30,
      "expect": [
        {
          "path": "gameplay.screen",
          "op": "eq",
          "value": "title"
        }
      ],
