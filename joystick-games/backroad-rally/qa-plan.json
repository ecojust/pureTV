    {
      "name": "Focus start",
      "keys": [
        "DOWN"
      ],
      "holdMs": 100,
      "timeoutSeconds": 30,
      "expect": [
        {
          "path": "gameplay.menuFocus",
          "op": "eq",
          "value": "开始"
        }
      ],
      "menuTap": true
    },
    {
      "name": "Start and wait for untouched warm-up/countdown",
      "keys": [
        "A"
      ],
      "holdMs": 100,
      "timeoutSeconds": 240,
      "expect": [
        {
          "path": "gameplay.phase",
          "op": "eq",
          "value": "running"
        },
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        }
      ],
      "menuTap": true
    },
    {
      "name": "Accelerate original Rapier car",
      "keys": [
        "UP"
      ],
      "holdMs": 3000,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.speed",
          "op": "changed"
        },
        {
          "path": "gameplay.speed",
          "op": "gt",
          "value": 2
        }
      ]
    },
    {
      "name": "Steer right with original handbrake",
      "keys": [
        "UP",
        "RIGHT",
        "A"
      ],
      "holdMs": 800,
      "timeoutSeconds": 30,
      "expect": [
        {
          "path": "gameplay.yaw",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Cycle original chase camera",
      "keys": [
        "X"
      ],
      "holdMs": 100,
      "timeoutSeconds": 30,
      "expect": [
        {
          "path": "gameplay.camera",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Toggle traction assist",
      "keys": [
        "Y"
      ],
      "holdMs": 100,
      "timeoutSeconds": 30,
      "expect": [
        {
          "path": "gameplay.tractionAssist",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Pause explicitly",
      "keys": [
        "START"
      ],
      "holdMs": 100,
      "timeoutSeconds": 30,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "paused"
        }
      ]
    },
    {
      "name": "Resume explicitly",
      "keys": [
        "START"
      ],
      "holdMs": 100,
      "timeoutSeconds": 30,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        }
      ]
    }
