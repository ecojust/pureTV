{
  "schemaVersion": 1,
  "renderer": "webgl2",
  "storageRestartRequired": true,
  "pauseStablePaths": [
    "gameplay.x",
    "gameplay.y",
    "gameplay.z",
    "gameplay.clock",
    "gameplay.penalties",
    "gameplay.recovers"
  ],
  "steps": [
    {
      "name": "Focus quick stage",
      "keys": [
        "DOWN"
      ],
      "holdMs": 100,
      "timeoutSeconds": 30,
      "expect": [
        {
          "path": "gameplay.menuFocus",
          "op": "eq",
          "value": "快速赛段"
        }
      ],
      "menuTap": true
    },
    {
      "name": "Focus time attack",
      "keys": [
        "DOWN"
      ],
      "holdMs": 100,
      "timeoutSeconds": 30,
      "expect": [
        {
          "path": "gameplay.menuFocus",
