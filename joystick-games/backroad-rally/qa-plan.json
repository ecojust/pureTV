{
  "schemaVersion": 1,
  "renderer": "webgl2",
  "storageRestartRequired": true,
  "pauseStablePaths": [
    "gameplay.x",
    "gameplay.y",
    "gameplay.z",
    "gameplay.clock",
    "gameplay.penalties",
    "gameplay.recovers"
