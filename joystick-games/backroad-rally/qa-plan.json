    {
      "name": "Accelerate original Rapier car",
      "keys": [
        "UP"
      ],
      "holdMs": 3000,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.speed",
          "op": "changed"
        },
        {
          "path": "gameplay.speed",
          "op": "gt",
          "value": 2
        }
      ]
    },
    {
      "name": "Steer right with original handbrake",
      "keys": [
        "UP",
        "RIGHT",
        "A"
      ],
      "holdMs": 800,
      "timeoutSeconds": 30,
      "expect": [
        {
          "path": "gameplay.yaw",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Cycle original chase camera",
      "keys": [
