{
  "schemaVersion": 1,
  "renderer": "webgl2",
  "storageRestartRequired": true,
  "pauseStablePaths": [
    "gameplay.time",
    "gameplay.position",
    "gameplay.speed",
    "gameplay.lap",
    "gameplay.driftCharge",
    "gameplay.boostTime"
  ],
  "steps": [
    {
      "name": "Open original roster from Start button",
      "keys": [
        "A"
      ],
      "holdMs": 180,
      "timeoutSeconds": 90,
      "expect": [
        {
          "path": "gameplay.menu",
          "op": "eq",
          "value": "select"
        },
        {
          "path": "gameplay.focus",
          "op": "eq",
          "value": "Start race"
        }
      ],
      "menuTap": true
    },
    {
      "name": "Start race and wait original countdown",
      "keys": [
        "A"
      ],
      "holdMs": 180,
      "timeoutSeconds": 240,
      "expect": [
        {
          "path": "gameplay.phase",
          "op": "eq",
          "value": "racing"
        }
      ],
      "windowsStartupWait": {
        "timeoutSeconds": 600
      }
    },
    {
      "name": "Accelerate original kart from grid",
      "keys": [
        "UP"
      ],
      "holdMs": 3500,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.speed",
          "op": "gt",
          "value": 1
        },
        {
          "path": "gameplay.position",
          "op": "changed"
        }
      ],
      "windowsHoldUntilExpect": true,
      "windowsReleaseWait": {
        "timeoutSeconds": 45
      }
    },
    {
      "name": "Steer and request original drift",
      "keys": [
        "UP",
        "RIGHT",
        "B"
      ],
      "holdMs": 1200,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.position",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Steer opposite direction and look back",
      "keys": [
        "A",
        "LEFT",
        "Y"
      ],
      "holdMs": 800,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.position",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Brake using original input",
      "keys": [
        "DOWN"
      ],
      "holdMs": 800,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.speed",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Request item through X (empty inventory is not an item-use claim)",
      "keys": [
        "X"
      ],
      "holdMs": 180,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.phase",
          "op": "eq",
          "value": "racing"
        }
      ]
    },
    {
      "name": "Pause original race",
      "keys": [
        "START"
      ],
      "holdMs": 180,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "paused",
          "op": "eq",
          "value": true
        }
      ]
    },
    {
      "name": "Deliberately resume with START held without re-pausing",
      "keys": [
        "START"
      ],
      "holdMs": 1200,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        },
        {
          "path": "paused",
          "op": "eq",
          "value": false
        }
      ]
    },
    {
      "name": "Continue actual driving after explicit resume",
      "keys": [
        "UP"
      ],
      "holdMs": 2000,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.speed",
          "op": "gt",
          "value": 1
        },
        {
          "path": "gameplay.position",
          "op": "changed"
        }
      ]
    }
  ],
  "windowsPauseWait": {
    "timeoutSeconds": 45
  }
}
