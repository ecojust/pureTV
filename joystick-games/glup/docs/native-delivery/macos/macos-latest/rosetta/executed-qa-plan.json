{
  "schemaVersion": 1,
  "renderer": "canvas2d",
  "storageRestartRequired": true,
  "pauseStablePaths": [
    "gameplay.tick",
    "gameplay.worldTick",
    "gameplay.playerX",
    "gameplay.playerY",
    "gameplay.hp",
    "gameplay.pearls",
    "gameplay.projectiles"
  ],
  "steps": [
    {
      "name": "Enter the original introduction",
      "keys": [
        "START"
      ],
      "holdMs": 700,
      "expect": [
        {
          "path": "gameplay.screen",
          "op": "eq",
          "value": "cine"
        },
        {
          "path": "gameplay.introTick",
          "op": "gte",
          "value": 30
        }
      ]
    },
    {
      "name": "Skip the opening film with a real confirm press",
      "keys": [
        "START"
      ],
      "holdMs": 700,
      "expect": [
        {
          "path": "gameplay.screen",
          "op": "eq",
          "value": "title"
        },
        {
          "path": "gameplay.titleTick",
          "op": "gte",
          "value": 170
        }
      ]
    },
    {
      "name": "Open the nine-location map",
      "keys": [
        "START"
      ],
      "holdMs": 700,
      "expect": [
        {
          "path": "gameplay.screen",
          "op": "eq",
          "value": "select"
        }
      ]
    },
    {
      "name": "Travel to Embarcadero by boat",
      "keys": [
        "START"
      ],
      "holdMs": 3200,
      "expect": [
        {
          "path": "gameplay.arrival",
          "op": "eq",
          "value": false
        },
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        }
      ]
    },
    {
      "name": "Walk right and meet Ruca for the original first conversation",
      "keys": [
        "RIGHT"
      ],
      "holdMs": 4000,
      "expect": [
        {
          "path": "gameplay.playerX",
          "op": "changed"
        },
        {
          "path": "gameplay.talking",
          "op": "eq",
          "value": true
        }
      ]
    },
    {
      "name": "Confirm the original Ruca speech normally (1/6)",
      "keys": [
        "A"
      ],
      "holdMs": 1600,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        }
      ]
    },
    {
      "name": "Confirm the original Ruca speech normally (2/6)",
      "keys": [
        "A"
      ],
      "holdMs": 1600,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        }
      ]
    },
    {
      "name": "Confirm the original Ruca speech normally (3/6)",
      "keys": [
        "A"
      ],
      "holdMs": 1600,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        }
      ]
    },
    {
      "name": "Confirm the original Ruca speech normally (4/6)",
      "keys": [
        "A"
      ],
      "holdMs": 1600,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        }
      ]
    },
    {
      "name": "Confirm the original Ruca speech normally (5/6)",
      "keys": [
        "A"
      ],
      "holdMs": 1600,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        }
      ]
    },
    {
      "name": "Confirm the original Ruca speech normally (6/6)",
      "keys": [
        "A"
      ],
      "holdMs": 1600,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        },
        {
          "path": "gameplay.talking",
          "op": "eq",
          "value": false
        }
      ]
    },
    {
      "name": "Jump with original vertical physics",
      "keys": [
        "A"
      ],
      "holdMs": 180,
      "expect": [
        {
          "path": "gameplay.playerY",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Use the catfish inhale cone",
      "keys": [
        "B"
      ],
      "holdMs": 450,
      "expect": [
        {
          "path": "gameplay.suckTicks",
          "op": "increased"
        }
      ]
    },
    {
      "name": "Pause explicitly",
      "keys": [
        "START"
      ],
      "holdMs": 180,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "paused"
        }
      ]
    },
    {
      "name": "Resume explicitly",
      "keys": [
        "START"
      ],
      "holdMs": 180,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        }
      ]
    }
  ]
}
