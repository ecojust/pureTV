{
  "schemaVersion": 1,
  "renderer": "webgl2",
  "storageRestartRequired": true,
  "pauseStablePaths": [
    "gameplay.raceTime",
    "gameplay.playerX",
    "gameplay.playerZ",
    "gameplay.heading",
    "gameplay.speed",
    "gameplay.nitro",
    "gameplay.coins"
  ],
  "steps": [
    {
      "name": "Move up from Start to the original Standard class control",
      "keys": [
        "UP"
      ],
      "holdMs": 180,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.menu.root",
          "op": "eq",
          "value": "title"
        },
        {
          "path": "gameplay.menu.focusIndex",
          "op": "eq",
          "value": 16
        }
      ],
      "menuTap": true
    },
    {
      "name": "Move right to the original Tuned class control without activating it",
      "keys": [
        "RIGHT"
      ],
      "holdMs": 180,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.menu.root",
          "op": "eq",
          "value": "title"
        },
        {
          "path": "gameplay.menu.focusIndex",
          "op": "eq",
          "value": 17
        }
      ],
      "menuTap": true
    },
    {
      "name": "Move down from the class controls to the original Garage button",
      "keys": [
        "DOWN"
      ],
      "holdMs": 180,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.menu.root",
          "op": "eq",
          "value": "title"
        },
        {
          "path": "gameplay.menu.focusId",
          "op": "eq",
          "value": "garagebtn"
        }
      ],
      "menuTap": true
    },
    {
      "name": "Move from Garage to the original Settings button",
      "keys": [
        "RIGHT"
      ],
      "holdMs": 180,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.menu.root",
          "op": "eq",
          "value": "title"
        },
        {
          "path": "gameplay.menu.focusId",
          "op": "eq",
          "value": "volbtn"
        }
      ],
      "menuTap": true
    },
    {
      "name": "Open the original Settings panel",
      "keys": [
        "A"
      ],
      "holdMs": 180,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.menu.root",
          "op": "eq",
          "value": "volume"
        },
        {
          "path": "gameplay.menu.focusId",
          "op": "eq",
          "value": "volclose"
        }
      ],
      "menuTap": true
    },
    {
      "name": "Move down from Close to the original Max quality option",
      "keys": [
        "DOWN"
      ],
      "holdMs": 180,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.menu.root",
          "op": "eq",
          "value": "volume"
        },
        {
          "path": "gameplay.menu.focusIndex",
          "op": "eq",
          "value": 5
        }
      ],
      "menuTap": true
    },
    {
      "name": "Move left to the original Ultra quality option",
      "keys": [
        "LEFT"
      ],
      "holdMs": 180,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.menu.root",
          "op": "eq",
          "value": "volume"
        },
        {
          "path": "gameplay.menu.focusIndex",
          "op": "eq",
          "value": 4
        }
      ],
      "menuTap": true
    },
    {
      "name": "Move left to the original High quality option",
      "keys": [
        "LEFT"
      ],
      "holdMs": 180,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.menu.root",
          "op": "eq",
          "value": "volume"
        },
        {
          "path": "gameplay.menu.focusIndex",
          "op": "eq",
          "value": 3
        }
      ],
      "menuTap": true
    },
    {
      "name": "Move left to the original Balanced quality option",
      "keys": [
        "LEFT"
      ],
      "holdMs": 180,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.menu.root",
          "op": "eq",
          "value": "volume"
        },
        {
          "path": "gameplay.menu.focusIndex",
          "op": "eq",
          "value": 2
        }
      ],
      "menuTap": true
    },
    {
      "name": "Move left to the original Low quality option",
      "keys": [
        "LEFT"
      ],
      "holdMs": 180,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.menu.root",
          "op": "eq",
          "value": "volume"
        },
        {
          "path": "gameplay.menu.focusIndex",
          "op": "eq",
          "value": 1
        }
      ],
      "menuTap": true
    },
    {
      "name": "Confirm original Low quality and wait for its ordinary page reload",
      "keys": [
        "A"
      ],
      "holdMs": 80,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.renderPreset",
          "op": "eq",
          "value": "low"
        },
        {
          "path": "gameplay.menu.root",
          "op": "eq",
          "value": "title"
        },
        {
          "path": "gameplay.menu.focusId",
          "op": "eq",
          "value": "start"
        },
        {
          "path": "gameplay.ready",
          "op": "eq",
          "value": true
        }
      ],
      "menuTap": true
    },
    {
      "name": "Start and wait for the original countdown to finish",
      "keys": [
        "START"
      ],
      "holdMs": 200,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.state",
          "op": "eq",
          "value": "race"
        },
        {
          "path": "paused",
          "op": "eq",
          "value": false
        },
        {
          "path": "gameplay.renderPreset",
          "op": "eq",
          "value": "low"
        }
      ]
    },
    {
      "name": "Accelerate after the original countdown",
      "keys": [
        "UP"
      ],
      "holdMs": 7000,
      "timeoutSeconds": 60,
      "expect": [
        {
          "path": "gameplay.state",
          "op": "eq",
          "value": "race"
        },
        {
          "path": "gameplay.speed",
          "op": "gt",
          "value": 1
        },
        {
          "path": "gameplay.playerX",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Steer left while accelerating",
      "keys": [
        "UP",
        "LEFT"
      ],
      "holdMs": 1400,
      "expect": [
        {
          "path": "gameplay.heading",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Steer right while accelerating",
      "keys": [
        "UP",
        "RIGHT"
      ],
      "holdMs": 1400,
      "expect": [
        {
          "path": "gameplay.heading",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Use one original nitro bottle with B",
      "keys": [
        "B"
      ],
      "holdMs": 180,
      "expect": [
        {
          "path": "gameplay.bottles",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Change the original camera with Y",
      "keys": [
        "Y"
      ],
      "holdMs": 180,
      "expect": [
        {
          "path": "gameplay.camera",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Reset to the original track with X",
      "keys": [
        "X"
      ],
      "holdMs": 180,
      "expect": [
        {
          "path": "gameplay.speed",
          "op": "lt",
          "value": 1
        }
      ]
    },
    {
      "name": "Pause the actual race",
      "keys": [
        "START"
      ],
      "holdMs": 180,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "paused"
        }
      ]
    },
    {
      "name": "Resume only on explicit input",
      "keys": [
        "START"
      ],
      "holdMs": 180,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        }
      ]
    }
  ]
}
