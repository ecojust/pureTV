{
  "schemaVersion": 1,
  "renderer": "webgl2",
  "pauseStablePaths": ["gameplay.distance", "gameplay.shots", "gameplay.x"],
  "steps": [
    {"name": "Launch a quick sortie and take control", "keys": ["START"], "holdMs": 100, "timeoutSeconds": 120, "expect": [{"path": "stage", "op": "eq", "value": "playing"}, {"path": "gameplay.controllable", "op": "eq", "value": true}]},
    {"name": "Steer the ship right", "keys": ["RIGHT"], "holdMs": 280, "expect": [{"path": "gameplay.x", "op": "changed"}]},
    {"name": "Fire the ship's cannon", "keys": ["A"], "holdMs": 280, "expect": [{"path": "gameplay.shots", "op": "increased"}]},
    {"name": "Use a bomb", "keys": ["B"], "holdMs": 120, "expect": [{"path": "gameplay.bombs", "op": "changed"}]},
    {"name": "Hold START to pause the sortie", "keys": ["START"], "holdMs": 750, "expect": [{"path": "stage", "op": "eq", "value": "paused"}]},
    {"name": "Hold START to resume the sortie once", "keys": ["START"], "holdMs": 1000, "expect": [{"path": "stage", "op": "eq", "value": "playing"}]}
  ]
}
