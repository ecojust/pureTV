{
  "schemaVersion": 1,
  "renderer": "webgl2",
  "pauseStablePaths": [
    "gameplay.tick",
    "gameplay.tool",
    "gameplay.turns",
    "gameplay.tests",
    "gameplay.phase"
  ],
  "steps": [
    {
      "name": "Open or continue the campaign",
      "keys": [
        "START"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        },
        {
          "path": "gameplay.phase",
          "op": "eq",
          "value": "dialogue"
        }
      ]
    },
    {
      "name": "Read intro dialogue line 1",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.line",
          "op": "eq",
          "value": 1
        }
      ]
    },
    {
      "name": "Read intro dialogue line 2",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.line",
          "op": "eq",
          "value": 2
        }
      ]
    },
    {
      "name": "Read intro dialogue line 3",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.line",
          "op": "eq",
          "value": 3
        }
      ]
    },
    {
      "name": "Read intro dialogue line 4",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.scene",
          "op": "eq",
          "value": "d1_open"
        }
      ]
    },
    {
      "name": "Read d1_open dialogue line 1",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.line",
          "op": "eq",
          "value": 1
        }
      ]
    },
    {
      "name": "Read d1_open dialogue line 2",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.line",
          "op": "eq",
          "value": 2
        }
      ]
    },
    {
      "name": "Read d1_open dialogue line 3",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.line",
          "op": "eq",
          "value": 3
        }
      ]
    },
    {
      "name": "Read d1_open dialogue line 4",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.line",
          "op": "eq",
          "value": 4
        }
      ]
    },
    {
      "name": "Read d1_open dialogue line 5",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.line",
          "op": "eq",
          "value": 5
        }
      ]
    },
    {
      "name": "Read d1_open dialogue line 6",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.phase",
          "op": "eq",
          "value": "shop"
        }
      ]
    },
    {
      "name": "Ring the shop bell for the first customer",
      "keys": [
        "A"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.scene",
          "op": "eq",
          "value": "mama_pre"
        }
      ]
    },
    {
      "name": "Read mama_pre dialogue line 1",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.line",
          "op": "eq",
          "value": 1
        }
      ]
    },
    {
      "name": "Read mama_pre dialogue line 2",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.line",
          "op": "eq",
          "value": 2
        }
      ]
    },
    {
      "name": "Read mama_pre dialogue line 3",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.line",
          "op": "eq",
          "value": 3
        }
      ]
    },
    {
      "name": "Read mama_pre dialogue line 4",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.line",
          "op": "eq",
          "value": 4
        }
      ]
    },
    {
      "name": "Read mama_pre dialogue line 5",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.phase",
          "op": "eq",
          "value": "brief"
        }
      ]
    },
    {
      "name": "Accept the noodle-bot work order",
      "keys": [
        "A"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.phase",
          "op": "eq",
          "value": "bench"
        }
      ]
    },
    {
      "name": "Move the repair cursor",
      "keys": [
        "RIGHT"
      ],
      "holdMs": 440,
      "expect": [
        {
          "path": "gameplay.cursorX",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Choose the next repair tool",
      "keys": [
        "B"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.tool",
          "op": "changed"
        }
      ]
    },
    {
      "name": "Run the original electrical test",
      "keys": [
        "X"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "gameplay.tests",
          "op": "increased"
        }
      ]
    },
    {
      "name": "Pause using the controller",
      "keys": [
        "START"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "paused"
        }
      ]
    },
    {
      "name": "Resume using START",
      "keys": [
        "START"
      ],
      "holdMs": 210,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "playing"
        }
      ]
    }
  ],
  "storageRestartRequired": true
}
