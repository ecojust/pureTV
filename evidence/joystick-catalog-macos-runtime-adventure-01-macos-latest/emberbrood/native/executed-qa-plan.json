    {
      "name": "Walk to the Low Fields using the original travel rule",
      "keys": [
        "A"
      ],
      "holdMs": 180,
      "expect": [
        {
          "path": "gameplay.node",
          "op": "eq",
          "value": "lowfields"
        },
        {
          "path": "gameplay.steps",
          "op": "increased"
        }
      ],
      "timeoutSeconds": 60
    },
    {
      "name": "Pause adventure",
      "keys": [
        "START"
      ],
      "holdMs": 180,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
          "value": "paused"
        }
      ],
      "timeoutSeconds": 60
    },
    {
      "name": "Resume explicitly",
      "keys": [
        "START"
      ],
      "holdMs": 180,
      "expect": [
        {
          "path": "stage",
          "op": "eq",
