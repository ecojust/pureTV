    {
      "name": "Select the Low Fields route",
      "keys": [
        "DOWN"
      ],
      "holdMs": 180,
      "expect": [
        {
          "path": "gameplay.screen",
          "op": "eq",
          "value": "map"
        }
      ],
      "timeoutSeconds": 60
