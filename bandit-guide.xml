g-clickable="false" password="false" selected="false" bounds="[196,215][1136,856]" drawing-order="1" hint=""><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="com.ecojust.hostedgames" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[196,215][1136,856]" drawing-order="1" hint=""><node index="0" text="方向键或左摇杆移动光标，确定 / A 点击，按住并移动可拖动。进入房间后切换到移动模式。方向控制移动，A 互动，X 冲刺，Y 使用技能。按 B、播放/暂停键或在帮助面板切换模式。 按菜单键或手柄 Start 打开操作说明。" resource-id="" class="android.widget.TextView" package="com.ecojust.hostedgames" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[208,227][1124,423]" drawing-order="1" hint="" /><node index="1" text="切换操作模式 · 光标模式" resource-id="" class="android.widget.Button" package="com.ecojust.hostedgames" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[208,423][1124,519]" drawing-order="3" hint="" /><node index="2" text="使用技能（Q）" resource-id="" class="android.widget.Button" package="com.ecojust.hostedgames" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[208,519][1124,615]" drawing-order="4" hint="" /><node index="3" text="在劫案模式中，逃脱者要在倒计时结束前将钻石送到撤离点。破坏者负责藏起钻石、守住屋子。&#10;&#10;《Bandit》现为多人版《Vault Breakers》。金库模式至少需要两人，可创建或加入房间。原作支持键鼠和标准手柄。&#10;1. 标题页的 PLAY 会快速匹配到公共房间。和朋友玩时，直接选 CREATE ROOM，选择 PRIVATE、HEIST 和人数，然后按 CREATE 建房。&#10;2. 在 SAFEHOUSE 把 ROOM CODE 发给同伴。同伴在标题页选 JOIN BY CODE 输入房间码。劫案至少两人，所有人选 READY 后由房主开始。每轮先看自己的角色。&#10;3. 逃脱者靠近家具长按 E 搜寻，找到钻石后送到 GETAWAY。用方向键移动，Shift 冲刺。标准手柄用摇杆移动、A 互动、RT 冲刺。&#10;&#10;原文对照&#10;PLAY  ·  快速加入公共房间&#10;CREATE ROOM  ·  打开建房设置&#10;JOIN BY CODE  ·  输入房间码加入&#10;SAFEHOUSE  ·  安全屋，等待同伴就绪&#10;ROOM CODE  ·  邀请同伴加入的房间码&#10;READY  ·  准备就绪&#10;Saboteur  ·  破坏者，负责防守&#10;Runners  ·  逃脱者，负责寻宝&#10;GETAWAY  ·  撤离点，送交钻石" resource-id="" class="android.widget.TextView" package="com.ecojust.hostedgames" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[208,615][1124,856]" drawing-order="2" hint="" /></node></node><node index="1" text="" resource-id="" class="android.widget.LinearLayout" package="com.ecojust.hostedgames" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1136,215][1724,856]" drawing-order="2" hint=""><node index="0" text="同一 Wi-Fi 下扫码连接手柄" resource-id="" class="android.widget.TextView" package="com.ecojust.hostedgames" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1148,231][1712,279]" drawing-order="1" hint="" /><node index="1" text="" resource-id="" class="android.widget.ImageView" package="com.ecojust.hostedgames" content-desc="手机手柄二维码" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1148,279][1712,471]" drawing-order="2" hint="" /><node index="2" text="[pairing address omitted]" resource-id="" class="android.widget.TextView" package="com.ecojust.hostedgames" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="fals