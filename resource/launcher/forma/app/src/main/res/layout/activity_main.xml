<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="#101419">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="48dp" android:paddingEnd="48dp"
        android:paddingTop="34dp" android:paddingBottom="24dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/leftBlock" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons" android:orientation="vertical">
                <TextView android:id="@+id/greeting" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:visibility="gone"/>
                <TextClock android:id="@+id/clock" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:format12Hour="h:mm"
                    android:format24Hour="HH:mm" android:textColor="#F5F5F5" android:textSize="52sp"
                    android:fontFamily="sans-serif-thin" android:includeFontPadding="false"/>
                <TextClock android:id="@+id/date" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:format12Hour="@string/date_format" android:format24Hour="@string/date_format"
                    android:textColor="#BFC3C8" android:textSize="13sp" android:fontFamily="sans-serif"/>
                <LinearLayout android:id="@+id/weatherLine" android:layout_width="wrap_content"
                    android:layout_height="40dp" android:layout_marginTop="5dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="6dp" android:paddingEnd="6dp"
                    android:background="@drawable/input_row_bg" android:focusable="true"
                    android:nextFocusRight="@id/btnWallpaper" android:nextFocusDown="@+id/grid"
                    android:visibility="gone">
                    <ImageView android:id="@+id/weatherIcon" android:layout_width="20dp"
                        android:layout_height="20dp" android:layout_marginEnd="8dp"
                        android:duplicateParentState="true" android:tint="@drawable/pill_text"
                        android:contentDescription="@null"/>
                    <TextView android:id="@+id/weatherText" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:duplicateParentState="true"
                        android:textColor="@drawable/pill_text" android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@id/topButtons" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true" android:orientation="horizontal">
                <TextView android:id="@+id/btnWallpaper" style="@style/TopButton"
                    android:text="@string/desktop" android:nextFocusDown="@id/grid"/>
                <TextView android:id="@+id/btnDock" style="@style/TopButton"
                    android:text="@string/favourites" android:nextFocusDown="@id/grid"/>
                <TextView android:id="@+id/btnInputs" style="@style/TopButton"
                    android:text="@string/inputs" android:nextFocusDown="@id/grid"/>
                <TextView android:id="@+id/btnWifi" style="@style/TopButton"
                    android:text="@string/network" android:nextFocusDown="@id/grid"/>
                <TextView android:id="@+id/btnSettings" style="@style/TopButton"
                    android:text="@string/settings" android:nextFocusDown="@id/grid"/>
            </LinearLayout>
        </RelativeLayout>
        <Space android:id="@+id/homeSpacer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@id/grid"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:clipChildren="false" android:clipToPadding="false"
            android:overScrollMode="never" android:scrollbars="none"
            android:descendantFocusability="afterDescendants"/>
        <TextView android:id="@+id/allAppsHint" android:layout_width="match_parent"
            android:layout_height="24dp" android:gravity="center"
            android:text="@string/all_apps_hint" android:textColor="#A2A7AF" android:textSize="11sp"
            android:clickable="true" android:focusable="false"/>
    </LinearLayout>
</FrameLayout>
