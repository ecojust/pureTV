<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/appsRoot" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#101419"
    android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="30dp"
    android:paddingBottom="24dp">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_alignParentStart="true">
            <TextView android:id="@+id/appsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/apps_heading" android:textSize="28sp" android:textColor="#F5F5F5"/>
            <TextView android:id="@+id/appsSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/apps_subtitle"
                android:textSize="13sp" android:textColor="#A2A7AF"/>
        </LinearLayout>
        <TextView android:id="@+id/backHome" style="@style/TopButton"
            android:layout_alignParentEnd="true" android:text="@string/back_home"
            android:nextFocusDown="@+id/appsGrid"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@id/appsGrid"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="28dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:clipChildren="false" android:clipToPadding="false"
        android:overScrollMode="never" android:scrollbars="none"
        android:descendantFocusability="afterDescendants"/>
</LinearLayout>

</FrameLayout>
