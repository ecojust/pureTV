<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingTop="6dp" android:paddingBottom="14dp"
    android:clipChildren="false" android:clipToPadding="false">
    <FrameLayout android:id="@+id/card"
        android:layout_width="190dp" android:layout_height="94dp"
        android:layout_gravity="top|center_horizontal"
        android:foreground="@drawable/card_focus"
        android:focusable="true" android:focusableInTouchMode="true" android:clickable="true">
        <ImageView android:id="@+id/icon"
            android:layout_width="38dp" android:layout_height="38dp"
            android:layout_gravity="center" android:contentDescription="@null"/>
    </FrameLayout>
    <TextView android:id="@+id/name"
        android:layout_width="190dp" android:layout_height="26dp"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="110dp"
        android:gravity="center" android:singleLine="true" android:ellipsize="end"
        android:textColor="#BFC3C8" android:textSize="14sp" android:fontFamily="sans-serif"/>
</FrameLayout>
