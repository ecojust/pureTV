<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Needed on Android 10 to read the Wi-Fi network name; optional; the compact navigation uses it only for accessibility status. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- For optional daily random wallpaper and weather, which stays off until the user turns it on. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ hides other packages from us unless we name them; the Settings/Wi-Fi fallback
         in MainActivity needs to see Xiaomi's own settings app. -->
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <package android:name="com.ecojust.webtv" />
        <package android:name="com.ecojust.shortvideo" />
        <package android:name="com.ecojust.music" />
        <package android:name="com.xiaomi.mitv.settings" />
        <package android:name="com.xiaodianshi.tv.yst" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="tv.danmaku.bilibilihd" />
        <package android:name="com.dangbeimarket" />
        <package android:name="com.android.vending" />
        <package android:name="com.xiaomi.mitv.appstore" />
        <package android:name="com.lonelycatgames.Xplore" />
        <package android:name="com.estrongs.android.pop" />
        <package android:name="com.google.android.apps.nbu.files" />
        <package android:name="com.android.fileexplorer" />
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_MARKET" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_FILES" /></intent>
        <intent><action android:name="android.intent.action.OPEN_DOCUMENT" /><category android:name="android.intent.category.OPENABLE" /><data android:mimeType="*/*" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.PureTV"
        android:allowBackup="false">

        <provider android:name=".LauncherLayoutProvider" android:authorities="com.ecojust.puretv.layout" android:exported="true" android:permission="android.permission.DUMP" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Quick settings, opened by the remote's Settings (选项) button through HomeKeyService.
             Its own task and no history, so the app behind keeps running and Back returns to it. -->
        <activity
            android:name=".QuickSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />

        <!-- Screensaver: pick it in Settings, or `settings put secure screensaver_components
             com.ecojust.puretv/.ClockDream` over adb. -->
        <service
            android:name=".ClockDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Remote Home button returns to the top (Xiaomi remotes send KEYCODE_ALL_APPS for Home).
             Off by default — only runs if the user enables it in Settings > Accessibility. Declaring
             it requests no permission at install; see HomeKeyService. -->
        <service
            android:name=".HomeKeyService"
            android:label="@string/home_key_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>
    </application>
</manifest>
