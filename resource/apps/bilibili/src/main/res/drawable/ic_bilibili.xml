<?xml version="1.0" encoding="utf-8"?>
<!-- Original simple TV mark; layer-list shapes also render on Android 4.4. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="64dp" android:height="64dp" />
            <corners android:radius="14dp" />
            <solid android:color="#385FD1" />
        </shape>
    </item>
    <item android:left="12dp" android:right="12dp" android:top="17dp" android:bottom="16dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:left="23dp" android:right="36dp" android:top="29dp" android:bottom="28dp">
        <shape android:shape="rectangle"><corners android:radius="2dp" /><solid android:color="#FFFFFF" /></shape>
    </item>
    <item android:left="36dp" android:right="23dp" android:top="29dp" android:bottom="28dp">
        <shape android:shape="rectangle"><corners android:radius="2dp" /><solid android:color="#FFFFFF" /></shape>
    </item>
</layer-list>
